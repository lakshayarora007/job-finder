# Optional API keys for scraper.py. Every one of these is optional - a source
# whose key is missing is simply skipped, everything else still runs.
#
# scraper.py reads these from real environment variables (it does not load a
# .env file by itself). Either export them in your shell / Task Scheduler, or
# put the same values in secrets.json instead (see secrets.example.json).

# Apify Console -> Settings -> API & Integrations -> Personal API token.
# Enables: LinkedIn jobs, LinkedIn hiring posts, Naukri, Indeed, Internshala.
APIFY_TOKEN=your_apify_token_here

# RapidAPI key subscribed to the free "JSearch" plan.
# Enables: Google for Jobs source.
JSEARCH_API_KEY=your_rapidapi_key_here

# build.nvidia.com API key (free tier).
# Enables: LLM parsing of LinkedIn hiring posts (falls back to regex without it).
NVIDIA_API_KEY=your_nvidia_api_key_here
